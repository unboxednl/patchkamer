        "frame": "line",
        "columns": 5,
        "gap": "tight",
        "bare": true,
        "labels": "below"
      },
      {
        "match": "group:pitch",
        "frame": "line",
        "columns": 5,
        "gap": "tight",
        "bare": true,
        "labels": "below"
      },
      {
        "match": "group:sect",
        "frame": "line",
        "columns": 5,
        "gap": "tight",
        "bare": true,
        "labels": "below"
      },
      {
        "match": "group:tone",
        "frame": "line",
        "columns": 5,
        "gap": "tight",
        "bare": true,
        "labels": "below"
      }
    ],
    "size": {

{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.5",
  "id": "nl.patchkamer.celestialmechanics.compact",
  "device": "nl.patchkamer.celestialmechanics",
  "name": "Compact",
  "version": "1.0.0",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: rotary knobs with the label underneath, the controls grouped in frames, a smaller sky and no status text.",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary"
      }
    ],
    "size": {
      "width": 480
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "A compact layout for small screens: rotary knobs with the label underneath, the controls grouped in frames, a smaller sky and no status text.",
      "css": ".app{display:flex;flex-wrap:wrap;gap:4px;padding:6px;border-radius:4px;font-size:9px;align-content:flex-start}\n.top{order:1;flex:1 1 100%;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;margin:0}\n.sel{display:grid;grid-template-columns:minmax(0,1fr);gap:0;font-size:7.5px;letter-spacing:0;min-width:0}\n.sel>span{order:2;text-align:center;line-height:1.1;text-transform:none;padding-top:1px}\n.sel>select{order:1;width:100%;font-size:8.5px;padding:3px 2px;appearance:none;-webkit-appearance:none;text-align:center;text-align-last:center;border-radius:3px}\ncanvas{order:2;flex:1 1 100%;height:190px;border-radius:4px}\n.acts{order:3;flex:1 1 100%;gap:4px;margin:0}\n.acts button{flex:1 1 auto;font-size:8.5px;padding:3px 4px;border-radius:3px}\n.st,h3{display:none}\n.grid{order:4;display:grid;gap:2px 0;border:1px solid var(--line,#2c3344);border-radius:4px;padding:3px 3px 4px;margin:0}\n.grid:nth-of-type(3){flex:4 1 200px;grid-template-columns:repeat(4,minmax(0,1fr))}\n.grid:nth-of-type(4){flex:4 1 200px;grid-template-columns:repeat(4,minmax(0,1fr))}\n.grid:nth-of-type(5){flex:3 1 150px;grid-template-columns:repeat(3,minmax(0,1fr))}\n.grid:nth-of-type(6){flex:3 1 150px;grid-template-columns:repeat(3,minmax(0,1fr))}\n.c{display:grid;grid-template-columns:minmax(0,1fr);justify-items:center;align-items:start;gap:0;min-width:0}\n.c .lab{display:contents}\n.c .lab>span{order:3;font-size:7.5px;text-align:center;line-height:1.1;text-transform:none;letter-spacing:-.02em}\n.c .lab>output{order:2;font-size:8px;line-height:1.1;white-space:nowrap}\n.c>.kn{order:1;width:26px!important;height:26px!important;justify-self:center!important}\n.c .kn svg{width:100%;height:100%}"
    }
  ]
}

{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.5",
  "id": "nl.patchkamer.cinematicsynth.compact",
  "device": "nl.patchkamer.cinematicsynth",
  "name": "Compact",
  "version": "1.0.0",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: rotary knobs with the label underneath and the knobs grouped per section in one frame, at roughly 60% of the standard width and a fraction of the height.",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary"
      }
    ],
    "size": {
      "width": 480
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "Rotary knobs in grouped frames, less than two thirds of the standard width.",
      "css": ".app{padding:5px;gap:4px;display:grid;grid-template-columns:repeat(8,minmax(0,1fr));font-size:8px;border-radius:5px}\n.grp{padding:3px 4px 4px;gap:2px;border-radius:3px;min-width:0;align-content:start}\n.grp:nth-child(1){grid-column:1/5;grid-row:1}\n.grp:nth-child(5){grid-column:5/9;grid-row:1}\n.grp:nth-child(2){grid-column:1/5;grid-row:2/4}\n.grp:nth-child(3){grid-column:5/9;grid-row:2}\n.grp:nth-child(4){grid-column:5/9;grid-row:3}\n.grp:nth-child(6){grid-column:1/7;grid-row:4}\n.grp:nth-child(7){grid-column:7/9;grid-row:4}\n.status{grid-column:1/-1;font-size:8px;line-height:1}\nh3{margin:0;font-size:8px;letter-spacing:.14em;line-height:1.1}\n.grid{grid-template-columns:repeat(auto-fill,minmax(44px,1fr));gap:2px 0}\n.grid>div{min-width:0}\n.k,.k[style]{display:grid!important;grid-template-columns:minmax(0,1fr)!important;justify-items:center;align-items:start;gap:0;min-width:0;zoom:1!important}\n.k label{order:3;font-size:7.5px;letter-spacing:-.03em;text-align:center;max-width:100%;line-height:1.1;white-space:normal;text-transform:none;min-width:0}\n.k output{order:2;font-size:8px;text-align:center;line-height:1.1;color:var(--muted);white-space:nowrap}\n.k .kn{order:1;width:26px!important;height:26px!important;justify-self:center!important}\n.k .kn svg{width:100%;height:100%}\nlabel.s{gap:1px;justify-items:center;text-align:center;align-content:start}\nlabel.s span{order:2;font-size:7.5px;letter-spacing:-.03em;line-height:1.1}\nlabel.s select{order:1;width:100%;font-size:8px;padding:3px 0;text-align:center;text-align-last:center;appearance:none;-webkit-appearance:none;border-radius:3px;cursor:pointer}\nlabel.c{grid-column:span 2;font-size:8px;gap:3px}"
    }
  ]
}
            "group:filter",
            "group:mod",
            "group:out"
          ],
          "style": "line",
          "cols": 6,
          "gap": "tight",
          "bare": true,
          "labels": "below",
          "width": "full"
        }
      ]
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "A compact layout for small screens: rotary knobs with the label underneath, all in one frame."
    }
  ]

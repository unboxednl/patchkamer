{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.5",
  "id": "nl.patchkamer.seq.compact",
  "device": "nl.patchkamer.seq",
  "name": "Compact",
  "version": "1.0.0",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: rotary knobs with the label underneath, the controls grouped in frames, one tight row of buttons and no explanatory text.",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary"
      }
    ],
    "size": {
      "width": 580
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "A compact layout for small screens: rotary knobs with the label underneath, the controls grouped in frames, one tight row of buttons and no explanatory text.",
      "css": ".app{padding:6px;border-radius:4px;font-size:9px;display:flex;flex-wrap:wrap;gap:4px;align-content:flex-start}\n.row{margin:0;gap:4px;align-items:flex-end;border:1px solid var(--line,#344953);border-radius:4px;padding:4px 5px}\n.row:nth-child(1){flex:7 1 350px;align-items:start}\n.row:nth-child(2){flex:2 1 110px}\n.row:nth-child(3){flex:1 1 100%;border:0;padding:0;flex-wrap:wrap}\ncanvas{flex:1 1 100%}\n.control{display:grid;grid-template-columns:minmax(0,1fr);justify-items:center;align-items:start;gap:0;border:0;padding:0;min-width:0;border-radius:0;flex:1 1 44px}\n.control>span:not(.kn){order:3;font-size:7.5px;text-align:center;line-height:1.1;max-width:100%;letter-spacing:-.02em}\n.control>output{order:2;font-size:8px;line-height:1.1;text-align:center;white-space:nowrap}\n.control>.kn{order:1;width:26px!important;height:26px!important;justify-self:center!important}\n.control .kn svg{width:100%;height:100%}\n.control>select{order:1;width:100%;font-size:8.5px;padding:3px 0;text-align:center;text-align-last:center;appearance:none;-webkit-appearance:none;border-radius:3px;cursor:pointer}\n.row:nth-child(2) .control:first-child{flex:2 1 70px}\nbutton{font-size:8px;padding:4px 4px;min-width:26px;border-radius:3px}\n.row:nth-child(3){gap:2px}\n.pager:empty{display:none}"
    }
  ]
}
{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.5",
  "id": "nl.patchkamer.scale-arpeggiator.compact",
  "device": "nl.patchkamer.scale-arpeggiator",
  "name": "Compact",
  "version": "1.0.1",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: rotary knobs with the label underneath, all controls in one frame, low pattern bars and no explanatory text.",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary"
      }
    ],
    "size": {
      "width": 400
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "A compact layout for small screens: rotary knobs with the label underneath, all controls in one frame, low pattern bars and no explanatory text.",
      "css": ".app{display:flex;flex-direction:column;gap:4px;padding:6px;border-radius:4px;font-size:9px}\n.grid{display:grid;grid-template-columns:repeat(84,minmax(0,1fr));gap:5px 4px;border:1px solid var(--line,#344953);border-radius:4px;padding:5px;margin:0;align-items:flex-end}\nh3{font-size:8.5px;margin:2px 0 -2px;line-height:1}\ncanvas{height:30px!important;border-radius:3px}\n.row{margin:0}\n.row button{font-size:8.5px;padding:3px 6px;border-radius:3px}\np{font-size:8px;margin:0;line-height:1.1}\n.control{display:grid;grid-template-columns:minmax(0,1fr);justify-items:center;align-items:start;gap:0;border:0;padding:0;min-width:0;border-radius:0;grid-column:span 12}\n.control:nth-child(-n+4){grid-column:span 21}\n.control:nth-child(n+5):nth-child(-n+7){grid-column:span 28}\n.control:nth-child(8){grid-column:1/span 12}\n.control>span:not(.kn){order:3;font-size:7.5px;text-align:center;line-height:1.1;max-width:100%;letter-spacing:-.02em}\n.control>output{order:2;font-size:8px;line-height:1.1;text-align:center;white-space:nowrap}\n.control>.kn{order:1;width:26px!important;height:26px!important;justify-self:center!important}\n.control .kn svg{width:100%;height:100%}\n.control>select{order:1;width:100%;font-size:8.5px;padding:3px 0;text-align:center;text-align-last:center;appearance:none;-webkit-appearance:none;border-radius:3px;cursor:pointer}"
    }
  ]
}
{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.7",
  "id": "nl.patchkamer.mono.compact",
  "device": "nl.patchkamer.mono",
  "name": "Compact",
  "version": "1.0.0",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: rotary knobs with the label underneath and the knobs grouped in framed panels.",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary",
        "size": "s"
      }
    ],
    "size": {
      "width": 340
    },
    "layout": {
      "flow": "auto",
      "panels": [
        {
          "id": "osc",
          "items": [
            "group:osc",
            "group:play"
          ],
          "style": "line",
          "cols": 4,
          "gap": "tight",
          "bare": true,
          "labels": "below",
          "width": "full"
        },
        {
          "id": "filter",
          "items": [
            "group:filter"
          ],
          "style": "line",
          "cols": 2,
          "gap": "tight",
          "bare": true,
          "labels": "below",
          "width": "half"
        },
        {
          "id": "env",
          "items": [
            "group:env",
            "group:out"
          ],
          "style": "line",
          "cols": 3,
          "gap": "tight",
          "bare": true,
          "labels": "below",
          "width": "half"
        }
      ]
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "A compact layout for small screens: rotary knobs with the label underneath and the knobs grouped in framed panels."
    }
  ]
}

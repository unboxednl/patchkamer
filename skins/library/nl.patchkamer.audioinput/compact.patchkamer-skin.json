{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.5",
  "id": "nl.patchkamer.audioinput.compact",
  "device": "nl.patchkamer.audioinput",
  "name": "Compact",
  "version": "1.0.0",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "test",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary"
      }
    ],
    "size": {
      "width": 480
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "Rotary knob, tighter rows, no explanatory text.",
      "css": ".app{display:grid!important;grid-template-columns:1fr 1fr 64px;align-items:center;gap:4px 8px;padding:6px 8px;font-size:11px}\n.row{display:flex;min-width:0;gap:4px 8px;flex-wrap:nowrap}\nlabel{gap:4px;min-width:0}\nselect,button{padding:3px 5px;font-size:11px}\n.row>select{flex:1;min-width:0}\n.row label select{flex:1;min-width:0}\n.row:nth-child(1){grid-area:1/1/2/4}\n.row:nth-child(2){grid-area:2/1/3/3}\n.row:nth-child(3){grid-area:3/1/4/3}\n.row:nth-child(3)>label:first-child{flex:1}\n.row:nth-child(5){grid-area:4/1/5/3}\n.row:nth-child(5)>label:first-child{flex:1}\n.row:nth-child(2)>label{flex:1}\n.gain{min-height:0;grid-area:2/3/5/4;justify-self:center}\n.row:nth-child(6){grid-area:5/1/6/4}\n.warn{display:none}\n.k,.k[style]{display:grid!important;grid-template-columns:minmax(0,1fr)!important;justify-items:center;align-items:start;gap:0;min-width:0}\n.k label{order:3;font-size:9px;text-align:center;line-height:1.1;display:block}\n.k output{order:2;font-size:9px;text-align:center;line-height:1.1;color:var(--muted);white-space:nowrap}\n.k .kn{order:1;width:30px!important;height:30px!important;justify-self:center!important}\n.meter{grid-template-columns:10px 1fr 28px;gap:4px;min-width:0}\n.meter:nth-child(7){grid-area:6/1/7/2}.meter:nth-child(8){grid-area:6/2/7/4}\n.status{grid-area:7/1/8/4;font-size:10px;line-height:1.2}"
    }
  ]
}

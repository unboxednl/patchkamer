{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.5",
  "id": "nl.patchkamer.graincloud.compact",
  "device": "nl.patchkamer.graincloud",
  "name": "Compact",
  "version": "1.0.0",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: rotary knobs with the label underneath, the knobs grouped per section in one frame and a smaller waveform, at roughly half the width and height of the standard card.",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary"
      }
    ],
    "size": {
      "width": 480
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "Rotary knobs in grouped frames, about half the standard size.",
      "css": ".app{padding:5px 6px 6px;border-radius:4px;font-size:9px}\n.top{gap:4px;margin-bottom:4px}\n.sel{gap:1px;font-size:7.5px;letter-spacing:.04em;flex:1 1 90px;min-width:0}\n.sel select{width:100%;font-size:10px;padding:3px 4px;border-radius:3px}\n.top button{font-size:10px;padding:3px 6px;border-radius:3px;flex:1 1 auto}\ncanvas{height:60px!important;border-radius:3px}\n.stt{margin:2px 0;font-size:9px}\nh3{font-size:8px;letter-spacing:.14em;margin:5px 0 2px;padding-top:0;border-top:0}\n.grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:2px 0;padding:3px 2px 4px;border:1px solid var(--line,#30363f);border-radius:3px}\n.c{display:grid;grid-template-columns:minmax(0,1fr);justify-items:center;align-items:start;gap:0}\n.c .lab{display:contents}\n.c .lab span{order:3;font-size:7.5px;letter-spacing:-.02em;text-align:center;max-width:100%;line-height:1.1;white-space:normal;overflow:visible;text-overflow:clip}\n.c .lab output{order:2;font-size:8px;text-align:center;line-height:1.1;color:var(--muted,#97a1ad)}\n.c .kn{order:1;width:26px!important;height:26px!important;justify-self:center!important}\n.c .kn svg{width:100%;height:100%}"
    }
  ]
}
{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.5",
  "id": "nl.patchkamer.masterdirector.compact",
  "device": "nl.patchkamer.masterdirector",
  "name": "Compact",
  "version": "1.0.1",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: the strength as a rotary knob, selects and options in tight rows, at about three quarters of the standard width and less than half the height.",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary"
      }
    ],
    "size": {
      "width": 400
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "Rotary knobs, grouped and tight, at a smaller width and height than the standard card.",
      "css": ".app{display:flex;flex-wrap:wrap;gap:3px 6px;align-items:center;padding:6px;font-size:9px}\n.row{display:contents}\n.row>span,label.row{font-size:9px}\nlabel.row{display:inline-flex;gap:3px;align-items:center}\nselect,button{font-size:9px;padding:2px 4px;border-radius:3px}\ninput[type=checkbox]{margin:0;width:12px;height:12px}\nlabel.row:has(output){flex:1 1 100%;gap:6px;justify-content:flex-start}\n.kn{width:26px!important;height:26px!important}\n.kn svg{width:100%;height:100%}\noutput{font-size:9px}\n.targets{flex:1 1 100%;gap:2px}\n.target{padding:2px 5px;gap:4px;border-radius:3px}\n.targets p{margin:0}\n.status{flex:1 1 100%;font-size:9px;line-height:1.3}"
    }
  ]
}

{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.5",
  "id": "nl.patchkamer.funkbass.compact",
  "device": "nl.patchkamer.funkbass",
  "name": "Compact",
  "version": "1.0.0",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: rotary knobs with the label underneath and the knobs grouped per section in one frame, at roughly half the width and height of the standard card.",
  "created": "2026-11-13",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary",
        "size": "s"
      }
    ],
    "sections": [
      {
        "match": "*",
        "frame": "line",
        "columns": 6,
        "gap": "tight",
        "bare": true,
        "labels": "below"
      },
      {
        "match": "group:sound",
        "columns": 2,
        "gap": "normal",
        "bare": false,
        "labels": "above"
      },
      {
        "match": "group:mode",
        "columns": 3,
        "gap": "tight",
        "bare": false
      },
      {
        "match": "group:try",
        "columns": 3,
        "gap": "tight",
        "bare": false
      }
    ],
    "size": {
      "width": 400
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "Rotary knobs in grouped frames, a good deal smaller than the standard card.",
      "css": ""
    }
  ]
}

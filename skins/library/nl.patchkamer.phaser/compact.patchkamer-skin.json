{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.7",
  "id": "nl.patchkamer.phaser.compact",
  "device": "nl.patchkamer.phaser",
  "name": "Compact",
  "version": "1.0.0",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: rotary knobs with the value and the label underneath, grouped per section in one frame, at roughly half the width and height of the standard card.",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary",
        "size": 0.9
      }
    ],
    "size": {
      "width": 300
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "Rotary knobs in grouped frames, a good deal smaller than the standard card.",
      "css": "",
      "design": {
        "layout": {
          "flow": "rows",
          "panels": [
            {
              "id": "all",
              "items": [
                "stages",
                "sync",
                "rate",
                "depth",
                "center",
                "fb",
                "stereo",
                "mix"
              ],
              "style": "line",
              "dir": "grid",
              "cols": 4,
              "gap": "tight",
              "bare": true,
              "labels": "below"
            }
          ]
        }
      }
    }
  ]
}

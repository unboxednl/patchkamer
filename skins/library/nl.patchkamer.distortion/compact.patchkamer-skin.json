{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.7",
  "id": "nl.patchkamer.distortion.compact",
  "device": "nl.patchkamer.distortion",
  "name": "Compact",
  "version": "1.0.0",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: rotary knobs with the name and value underneath, grouped in framed panels.",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary",
        "size": "m"
      }
    ],
    "size": {
      "width": 400
    },
    "layout": {
      "flow": "auto",
      "panels": [
        {
          "id": "mode",
          "items": [
            "type",
            "os",
            "auto"
          ],
          "style": "line",
          "cols": 3,
          "gap": "tight",
          "bare": true,
          "labels": "above",
          "width": "full"
        },
        {
          "id": "drive",
          "items": [
            "drive",
            "bias",
            "lowcut",
            "tilt",
            "gate"
          ],
          "style": "line",
          "cols": 5,
          "gap": "tight",
          "bare": true,
          "labels": "below",
          "width": "full"
        },
        {
          "id": "post",
          "items": [
            "touch",
            "tone",
            "presence",
            "out",
            "mix"
          ],
          "style": "line",
          "cols": 5,
          "gap": "tight",
          "bare": true,
          "labels": "below",
          "width": "full"
        }
      ]
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "A compact layout for small screens: rotary knobs with the name and value underneath, grouped in framed panels."
    }
  ]
}

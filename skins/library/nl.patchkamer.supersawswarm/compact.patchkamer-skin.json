{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.5",
  "id": "nl.patchkamer.supersawswarm.compact",
  "device": "nl.patchkamer.supersawswarm",
  "name": "Compact",
  "version": "1.0.0",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: rotary knobs with the label underneath, the knobs grouped per section in one frame and a tighter gate row, at roughly half the width and half the height of the standard card.",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary"
      }
    ],
    "size": {
      "width": 480
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "Rotary knobs in grouped frames, much narrower than the standard card.",
      "css": "h3{font-size:8px;letter-spacing:.14em;margin:5px 0 2px;padding:0;border:0}\n.app{padding:6px 6px 7px;border-radius:4px;font-size:9px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:6px;align-content:start}\n.top,.acts,.app>h3:nth-of-type(n+2):not(:nth-of-type(3)),.app>div.grid:nth-of-type(n+4):not(:nth-of-type(5)){grid-column:1/-1}\n.top{grid-row:1}.acts{grid-row:2}\n.app>h3:nth-of-type(1){grid-column:1;grid-row:3}.app>div.grid:nth-of-type(3){grid-column:1;grid-row:4}\n.app>h3:nth-of-type(3){grid-column:2;grid-row:3}.app>div.grid:nth-of-type(5){grid-column:2;grid-row:4}\n\n.top{grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;margin:0 0 2px}\n.sel{gap:1px;font-size:7.5px;letter-spacing:0;min-width:0}\nselect{font-size:9px;padding:3px 2px;border-radius:3px;min-width:0;width:100%}\n.acts{margin:3px 0 0;gap:4px}\n.acts button{font-size:9px;padding:2px 8px;border-radius:3px}\n.grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:3px 0;border:1px solid var(--line,#33434d);border-radius:3px;padding:4px 3px 4px}\n.c{display:grid;grid-template-columns:minmax(0,1fr);justify-items:center;align-items:start;gap:0}\n.c:not([style]) .lab{display:contents}\n.c:not([style]) .lab span{order:3;font-size:7.5px;letter-spacing:-.02em;line-height:1.1;text-align:center;white-space:normal;overflow:visible;text-overflow:clip;max-width:100%}\n.c:not([style]) .lab output{order:2;font-size:8px;line-height:1.1;color:var(--muted,#9fb2ba);text-align:center}\n.c .kn{order:1;width:26px!important;height:26px!important;justify-self:center!important}\n.c .kn svg{width:100%;height:100%}\n.c[style]{justify-items:stretch}\n.c[style] .lab{font-size:7px;letter-spacing:0;justify-content:center}\n.gate{gap:2px;margin-top:2px}\n.gate button{height:13px;border-radius:2px}\n.app>div.grid:nth-of-type(3),.app>div.grid:nth-of-type(5){grid-template-columns:repeat(4,minmax(0,1fr))}"
    }
  ]
}
{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.7",
  "id": "nl.patchkamer.resonator.compact",
  "device": "nl.patchkamer.resonator",
  "name": "Compact",
  "version": "1.0.0",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: the two choices on top, the knobs with the label underneath in one frame.",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary",
        "size": "s"
      }
    ],
    "size": {
      "width": 336
    },
    "layout": {
      "flow": "auto",
      "panels": [
        {
          "id": "choice",
          "items": [
            "chord",
            "follow"
          ],
          "style": "line",
          "cols": 2,
          "gap": "tight",
          "bare": true,
          "labels": "above",
          "width": "full"
        },
        {
          "id": "knobs",
          "items": [
            "root",
            "tune",
            "detune",
            "decay",
            "damp",
            "mix",
            "gain"
          ],
          "style": "line",
          "cols": 4,
          "gap": "tight",
          "bare": true,
          "labels": "below",
          "width": "full"
        }
      ]
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "A compact layout for small screens: the two choices on top, the knobs with the label underneath in one frame."
    }
  ]
}

{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.5",
  "id": "nl.patchkamer.chordpoly.compact",
  "device": "nl.patchkamer.chordpoly",
  "name": "Compact",
  "version": "1.0.0",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: rotary knobs with the value and label underneath, the knobs grouped per section in one frame, a slim scope and compact selects, at roughly 57% of the standard width and about a third of the height.",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary"
      }
    ],
    "size": {
      "width": 480
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "Rotary knobs in grouped frames, less than 60% of the standard width.",
      "css": ".app{padding:5px;border-radius:5px;font-size:8px}\n.row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:3px 4px;margin:0 0 4px;align-items:end}\n.row .control{display:grid;grid-template-columns:minmax(0,1fr);gap:1px;padding:0;border:0;border-radius:0;justify-items:center;text-align:center}\n.row .control span{order:2;font-size:7.5px;line-height:1.1;letter-spacing:-.03em}\n.row .control select,.row .control input{order:1;width:100%;font-size:8px;padding:3px 2px;text-align:center;text-align-last:center;border-radius:3px}\n.row .control select{appearance:none;-webkit-appearance:none;cursor:pointer}\n.row .control:nth-child(4){grid-column:1/2}\n.row button{font-size:8px;padding:3px 2px;border-radius:3px;min-width:0}\ncanvas{height:28px;border-radius:3px;margin:0 0 4px}\n.grid{display:flex;flex-wrap:wrap;gap:4px}\n.grp{display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));align-content:start;gap:2px 0;padding:3px 4px 4px;border:1px solid var(--line,#344953);border-radius:3px;min-width:0;flex:var(--n) 1 calc(var(--n) * 46px + 8px)}\n.grp::before{content:attr(data-t);grid-column:1/-1;font-size:8px;letter-spacing:.14em;text-transform:uppercase;line-height:1.1;color:var(--muted,#adc3c9);padding-bottom:1px}\n.grp[data-g=filter]{--n:3;order:1}\n.grp[data-g=osc]{--n:3;order:2}\n.grp[data-g=out]{--n:1;order:3;flex:1 1 54px}\n.grp[data-g=env]{--n:4;order:4}\n.grp[data-g=fx]{--n:3;order:5}\n.control[data-pk-face],.grp .control{display:grid;grid-template-columns:minmax(0,1fr);justify-items:center;align-items:start;gap:0;padding:0;border:0;border-radius:0;min-width:0}\n.grp .control span:not(.kn){order:3;font-size:7.5px;letter-spacing:-.03em;text-align:center;max-width:100%;line-height:1.1;color:var(--muted,#adc3c9)}\n.grp .control output{order:2;font-size:8px;text-align:center;line-height:1.1;white-space:nowrap}\n.grp .control .kn{order:1;width:26px!important;height:26px!important;justify-self:center!important}\n.grp .control .kn svg{width:100%;height:100%}"
    }
  ]
}
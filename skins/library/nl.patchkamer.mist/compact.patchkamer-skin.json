{
  "format": "patchkamer-skin",
  "formatVersion": 1,
  "skinsContract": "0.7",
  "id": "nl.patchkamer.mist.compact",
  "device": "nl.patchkamer.mist",
  "name": "Compact",
  "version": "1.0.0",
  "author": "Freek van Gool",
  "license": "CC0-1.0",
  "description": "A compact layout for small screens: rotary knobs with the label underneath, grouped per section in one frame, at roughly half the height of the standard card.",
  "created": "2026-11-10",
  "icon": null,
  "default": "compact",
  "design": {
    "controls": [
      {
        "match": "role:param",
        "face": "rotary",
        "size": "s"
      }
    ],
    "size": {
      "width": 480
    },
    "layout": {
      "flow": "auto",
      "panels": [
        {
          "id": "sel",
          "items": [
            "preset",
            "mode",
            "chord"
          ],
          "style": "plain",
          "cols": 3,
          "gap": "tight",
          "bare": true,
          "labels": "above",
          "width": "full"
        },
        {
          "id": "play",
          "items": [
            "melody",
            "density",
            "evolve",
            "warmth",
            "detune",
            "root",
            "level"
          ],
          "style": "line",
          "cols": 7,
          "gap": "tight",
          "bare": true,
          "labels": "below",
          "width": "full"
        },
        {
          "id": "sound",
          "items": [
            "cutoff",
            "air",
            "motion",
            "space",
            "echo",
            "attack",
            "release"
          ],
          "style": "line",
          "cols": 7,
          "gap": "tight",
          "bare": true,
          "labels": "below",
          "width": "full"
        },
        {
          "id": "rest",
          "items": [
            "*"
          ],
          "style": "plain"
        }
      ]
    }
  },
  "appearances": [
    {
      "id": "compact",
      "name": "Compact",
      "description": "Rotary knobs in grouped frames.",
      "css": ""
    }
  ]
}
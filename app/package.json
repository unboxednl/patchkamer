{
  "name": "patchkamer-app",
  "productName": "Patchkamer",
  "version": "0.1.0",
  "description": "Patchkamer as a desktop app: the same host in its own window, with the bundled library.",
  "main": "main.js",
  "license": "AGPL-3.0-or-later",
  "author": "Freek van Gool",
  "private": true,
  "scripts": {
    "start": "electron .",
    "probe": "electron . --probe",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "nl.patchkamer.app",
    "productName": "Patchkamer",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "probe.html", "library.js", "package.json"],
    "extraResources": [
      { "from": "../patchkamer/patchkamer.html", "to": "patchkamer/patchkamer.html" },
      { "from": "../patchkamer/css", "to": "patchkamer/css", "filter": ["*.css"] },
      { "from": "../patchkamer/js", "to": "patchkamer/js", "filter": ["*.js"] },
      { "from": "../patchkamer/i18n", "to": "patchkamer/i18n", "filter": ["*.js"] },
      { "from": "../devices", "to": "library/devices", "filter": ["**/*.js", "**/*.json"] },
      { "from": "../presets", "to": "library/presets", "filter": ["**/*.json"] },
      { "from": "../tunes", "to": "library/tunes", "filter": ["**/*.json"] }
    ],
    "win": { "target": "portable", "artifactName": "Patchkamer-${version}-portable.exe" }
  }
}
